<div id="search" data-pagefind-ui></div>
<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script>
  // @ts-ignore — no type declarations for pagefind
  import { PagefindUI } from '@pagefind/default-ui';
  function initSearch() {
    const el = document.querySelector('#search');
    if (el instanceof HTMLElement && !el.dataset.pagefindReady) {
      const ui = new PagefindUI({ element: '#search', showSubResults: true });
      el.dataset.pagefindReady = 'true';
      const query = new URLSearchParams(window.location.search).get('q');
      if (query && typeof ui.triggerSearch === 'function') {
        ui.triggerSearch(query);
      }
    }
  }
  document.addEventListener('astro:page-load', initSearch);
</script>
