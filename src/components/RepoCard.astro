---
interface Props {
  name: string;
  description: string;
  url: string;
  language: string;
  languageColor: string;
  stars: number;
  forks: number;
}

const { name, description, url, language, languageColor, stars, forks } = Astro.props;
---

<div class="repo-card">
  <a href={url} target="_blank" rel="noopener noreferrer" class="repo-name">{name}</a>
  <p class="repo-description">{description}</p>
  <div class="repo-meta">
    {language && (
      <span class="repo-language">
        <span class="language-dot" style={`background-color: ${languageColor}`}></span>
        {language}
      </span>
    )}
    {stars > 0 && (
      <span class="repo-stat">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z"></path></svg>
        {stars}
      </span>
    )}
    {forks > 0 && (
      <span class="repo-stat">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 0-1.5 0v.878H6.75v-.878a2.25 2.25 0 1 0-1.5 0ZM8 1.25a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5Zm-2.25 0a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5ZM8 10a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 8 10Zm0 7a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z"></path></svg>
        {forks}
      </span>
    )}
  </div>
</div>
