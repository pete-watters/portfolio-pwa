---
import SocialMedia from './SocialMedia.astro';
import { ROUTES } from '../consts';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav>
  <a href={ROUTES.WORK} class={pathname.startsWith(ROUTES.WORK) ? 'active' : ''}>Work</a>
  <a href={ROUTES.BLOG} class={pathname.startsWith(ROUTES.BLOG) ? 'active' : ''}>Blog</a>
  <a href={ROUTES.ABOUT} class={pathname.startsWith(ROUTES.ABOUT) ? 'active' : ''}>About</a>
  <SocialMedia />
</nav>
