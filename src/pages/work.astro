---
import BaseLayout from '../layouts/BaseLayout.astro';
import RepoCard from '../components/RepoCard.astro';
import { SOCIAL } from '../consts';

interface PinnedRepo {
  name: string;
  description: string;
  url: string;
  stargazerCount: number;
  forkCount: number;
  primaryLanguage: { name: string; color: string } | null;
}

let repos: PinnedRepo[] = [];
let fetchError = false;

const token = import.meta.env.GITHUB_TOKEN;
if (token) {
  try {
    const response = await fetch('https://api.github.com/graphql', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        query: `{
          user(login: "pete-watters") {
            pinnedItems(first: 6, types: REPOSITORY) {
              nodes {
                ... on Repository {
                  name
                  description
                  url
                  stargazerCount
                  forkCount
                  primaryLanguage { name color }
                }
              }
            }
          }
        }`
      }),
    });
    const json = await response.json();
    repos = json.data?.user?.pinnedItems?.nodes ?? [];
  } catch {
    fetchError = true;
  }
} else {
  fetchError = true;
}
---

<BaseLayout title="Work" description="Open source contributions and portfolio by Pete Watters">
  <article>
    <h2>Work</h2>
    <ul class="about-tabs" role="tablist">
      <li><button role="tab" aria-selected="true" data-tab="opensource">Open Source</button></li>
      <li><button role="tab" aria-selected="false" data-tab="portfolio">Portfolio</button></li>
    </ul>

    <div class="tab-panel active" data-panel="opensource">
      {repos.length > 0 ? (
        <div class="repo-grid">
          {repos.map((repo) => (
            <RepoCard
              name={repo.name}
              description={repo.description ?? ''}
              url={repo.url}
              language={repo.primaryLanguage?.name ?? ''}
              languageColor={repo.primaryLanguage?.color ?? '#ccc'}
              stars={repo.stargazerCount}
              forks={repo.forkCount}
            />
          ))}
        </div>
      ) : (
        <p>
          <a href={SOCIAL.GITHUB} target="_blank" rel="noopener noreferrer">View my repos on GitHub</a>
        </p>
      )}
    </div>

    <div class="tab-panel" data-panel="portfolio">
      <div class="portfolio-entry">
        <h3>petewatters.ie</h3>
        <p>This website is a lightweight PWA built with Astro, deployed to Cloudflare Pages via GitHub Actions CI/CD.</p>
        <p>The stack includes Vitest and Playwright for testing, content collections for the blog, and @vite-pwa/astro for service worker generation.</p>
        <p>The proof is in the lighthouse score</p>
        <img src="/img/work/lighthouse.jpg" alt="Lighthouse score - 100%" />
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab!;
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      panels.forEach((p) => p.classList.toggle('active', p.dataset.panel === target));
    });
  });
</script>
