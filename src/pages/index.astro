      <article class="case-card" data-reveal>
        <div class="case-card-visual case-card-visual--xapo">
          <img src="/img/work/xapo/account.png" alt="Xapo wallet — multi-currency balances and debit card" width="1200" height="1200" loading="lazy" />
        </div>
