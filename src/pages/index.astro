            <li>Ethereum</li>
            <li>DeFi</li>
            <li>Institutional</li>
            <li>MetaMask</li>
            <li>Node.js</li>
          </ul>
          <a class="case-card-link" href="/work/qredo/">
            View case study <span class="arrow" aria-hidden="true">→</span>
