---
import Icon from '../components/Icon.astro';
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';
import { SOCIAL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  tagline: string;
}

const { title, description, tagline } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <header>
      <div class="header-inner">
        <h1 class="brand-name"><a href="https://petewatters.ie">Pete Watters</a></h1>
        <nav class="cv-nav">
          <a href={SOCIAL.GITHUB} target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
            <Icon name="github" />
          </a>
          <a href={SOCIAL.STACKOVERFLOW} target="_blank" rel="noopener noreferrer" aria-label="StackOverflow" title="StackOverflow">
            <Icon name="stackoverflow" />
          </a>
        </nav>
      </div>
    </header>
    <main>
      <div class="cv">
        <div class="cv-intro">
          <p class="tagline">{tagline}</p>
        </div>
        <slot />
      </div>
    </main>
    <script>
      document.querySelectorAll('.cv a[href]').forEach(a => {
        const href = a.getAttribute('href');
        if (href && (href.startsWith('http') || href.startsWith('//'))) {
          a.setAttribute('target', '_blank');
          a.setAttribute('rel', 'noopener noreferrer');
        }
      });
    </script>
  </body>
</html>

<style>
  header {
    display: block;
    padding: 1rem 2rem;
    background-color: #2B2B2B;
    color: white;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  header :global(a) {
    color: white;
  }

  .header-inner {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .header-inner :global(h1) {
    margin: 0;
    text-align: left;
  }

  .cv-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cv-nav :global(svg) {
    width: 18px;
    height: 18px;
  }

  main {
    text-align: left;
    display: block;
    max-width: 52rem;
    margin: 0 auto;
    padding: 2rem;
  }

  .cv-intro {
    margin-bottom: 1rem;
    border-bottom: 2px solid #cccccc;
    padding-bottom: 0.75rem;
  }

  .tagline {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.9rem;
    color: #555555;
    margin: 0;
  }

  /* Section headings: Skills, Work Experience, Education, etc. */
  .cv :global(h2) {
    font-family: 'Roboto Mono', monospace;
    font-size: 1.1rem;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    font-weight: 700;
    border-bottom: 2px solid #111111;
    padding-bottom: 0.25rem;
    margin: 1.5rem 0 0.75rem;
  }

  /* Job company + title lines */
  .cv :global(h3) {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.95rem;
    font-weight: 700;
    margin: 1.25rem 0 0.25rem;
  }

  .cv :global(h3 a) {
    font-family: 'Roboto Mono', monospace;
    font-weight: 700;
    opacity: 1;
    text-decoration: underline;
  }

  /* Inline dates floated right within h3 */
  .cv :global(h3 em) {
    float: right;
    font-family: 'Roboto Mono', monospace;
    font-size: 0.75rem;
    font-weight: 400;
    color: #888888;
  }

  /* Job context blockquotes */
  .cv :global(blockquote) {
    margin: 0.25rem 0;
    padding: 0 0 0 1rem;
    border-left: 3px solid #cccccc;
    color: #555555;
  }

  .cv :global(blockquote p) {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    margin: 0;
    line-height: 1.4;
  }

  /* Bullet points */
  .cv :global(ul) {
    margin: 0.25rem 0;
    padding-left: 1.25rem;
  }

  .cv :global(li) {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    line-height: 1.5;
    margin-bottom: 0.25rem;
    color: #111111;
  }

  /* Regular paragraphs */
  .cv :global(p) {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #111111;
  }

  /* Links in body */
  .cv :global(a) {
    color: #111111;
    text-decoration: underline;
  }

  /* Skills grid (dl/dt/dd) */
  .cv :global(dl) {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.25rem 0.75rem;
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    margin-bottom: 1rem;
  }

  .cv :global(dt) {
    font-weight: 700;
    color: #333333;
  }

  .cv :global(dd) {
    color: #444444;
    margin: 0;
  }

  /* Print styles */
  @media print {
    header {
      padding: 0.5rem 1rem;
      background-color: #2B2B2B !important;
      color: white !important;
    }

    header :global(a) {
      color: white !important;
    }

    header :global(h1) {
      font-size: 1.5rem;
    }

    .cv-nav :global(svg) {
      width: 14px;
      height: 14px;
    }

    main {
      padding: 0.5rem 1rem;
    }

    .cv-intro {
      margin-bottom: 0.5rem;
      padding-bottom: 0.5rem;
    }

    .tagline {
      font-size: 0.75rem;
    }

    .cv :global(h2) {
      margin: 0.75rem 0 0.35rem;
      font-size: 0.85rem;
    }

    .cv :global(h3) {
      margin: 0.6rem 0 0.1rem;
      font-size: 0.75rem;
    }

    .cv :global(p) {
      font-size: 0.7rem;
      line-height: 1.4;
    }

    .cv :global(li) {
      margin-bottom: 0.1rem;
      font-size: 0.7rem;
      line-height: 1.35;
    }

    .cv :global(ul) {
      margin: 0.15rem 0;
    }

    .cv :global(blockquote) {
      margin: 0.15rem 0;
    }

    .cv :global(blockquote p) {
      font-size: 0.65rem;
      line-height: 1.35;
    }

    .cv :global(h3 em) {
      font-size: 0.6rem;
    }

    .cv :global(dl) {
      font-size: 0.7rem;
      gap: 0.1rem 0.5rem;
      grid-template-columns: 5.5rem 1fr;
      margin-bottom: 0.5rem;
    }

    .cv :global(a) {
      color: #111111;
    }

    .cv :global(a[href]:after) {
      content: none;
    }
  }
</style>
