---
import Sidebar from '../components/Sidebar.astro';
import BaseHead from '../components/BaseHead.astro';
import { SOCIAL } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  tagline: string;
}

const { title, description, tagline } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <div class="app-shell">
      <Sidebar />
      <main>
        <div class="cv">
          <header class="cv-print-header">
            <p class="cv-print-name">Pete Watters</p>
            <p class="cv-print-title">Senior Software Engineer · React / TypeScript / Next.js · Bitcoin & Web3 · Dublin, Ireland</p>
            <p class="cv-print-links">
              <a href="https://petewatters.ie">petewatters.ie</a> ·
              <a href={SOCIAL.LINKEDIN}>linkedin.com/in/pete-watters</a> ·
              <a href={SOCIAL.GITHUB}>github.com/pete-watters</a> ·
              <a href="mailto:pete@cteic.ie">pete@cteic.ie</a>
            </p>
          </header>
          <div class="cv-intro">
            <p class="tagline">{tagline}</p>
          </div>
          <slot />
        </div>
      </main>
    </div>
    <script>
      function markCvExternalLinks() {
        document.querySelectorAll('.cv a[href]').forEach(a => {
          const href = a.getAttribute('href');
          if (href && (href.startsWith('http') || href.startsWith('//'))) {
            a.setAttribute('target', '_blank');
            a.setAttribute('rel', 'noopener noreferrer');
          }
        });
      }
      document.addEventListener('astro:page-load', markCvExternalLinks);
    </script>
  </body>
</html>

<style>
  .cv-print-header {
    display: none;
  }

  main {
    text-align: left;
    display: block;
    max-width: 52rem;
    margin: 0 auto;
    padding: 2rem;
  }

  .cv-intro {
    margin-bottom: 1rem;
    border-bottom: 2px solid #cccccc;
    padding-bottom: 0.75rem;
  }

  .tagline {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.9rem;
    color: #555555;
    margin: 0;
  }

  /* Section headings: Skills, Work Experience, Education, etc. */
  .cv :global(h2) {
    font-family: 'Roboto Mono', monospace;
    font-size: 1.1rem;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    font-weight: 700;
    border-bottom: 2px solid #111111;
    padding-bottom: 0.25rem;
    margin: 1.5rem 0 0.75rem;
  }

  /* Job company + title lines */
  .cv :global(h3) {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.95rem;
    font-weight: 700;
    margin: 1.25rem 0 0.25rem;
  }

  .cv :global(h3 a) {
    font-family: 'Roboto Mono', monospace;
    font-weight: 700;
    opacity: 1;
    text-decoration: underline;
  }

  /* Inline dates floated right within h3 */
  .cv :global(h3 em) {
    float: right;
    font-family: 'Roboto Mono', monospace;
    font-size: 0.75rem;
    font-weight: 400;
    color: #6b6b6b;
  }

  /* Job context blockquotes */
  .cv :global(blockquote) {
    margin: 0.25rem 0;
    padding: 0 0 0 1rem;
    border-left: 3px solid #cccccc;
    color: #555555;
  }

  .cv :global(blockquote p) {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    margin: 0;
    line-height: 1.4;
  }

  /* Bullet points */
  .cv :global(ul) {
    margin: 0.25rem 0;
    padding-left: 1.25rem;
  }

  .cv :global(li) {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    line-height: 1.5;
    margin-bottom: 0.25rem;
    color: #111111;
  }

  /* Regular paragraphs */
  .cv :global(p) {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #111111;
  }

  /* Links in body */
  .cv :global(a) {
    color: #111111;
    text-decoration: underline;
  }

  /* Skills grid (dl/dt/dd) */
  .cv :global(dl) {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.25rem 0.75rem;
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    margin-bottom: 1rem;
  }

  .cv :global(dt) {
    font-weight: 700;
    color: #333333;
  }

  .cv :global(dd) {
    color: #444444;
    margin: 0;
  }

  /* Print styles */
  @media print {
    .cv-print-header {
      display: block;
      margin-bottom: 0.6rem;
      padding-bottom: 0.4rem;
      border-bottom: 2px solid #111111;
    }

    .cv-print-header .cv-print-name {
      font-family: 'Space Grotesk', var(--font-sans);
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.01em;
      color: #111111;
      margin: 0 0 0.15rem;
    }

    .cv-print-header .cv-print-title {
      font-family: var(--font-sans);
      font-size: 0.8rem;
      line-height: 1.4;
      color: #333333;
      margin: 0 0 0.2rem;
    }

    .cv-print-header .cv-print-links {
      font-family: var(--font-sans);
      font-size: 0.72rem;
      line-height: 1.4;
      color: #555555;
      margin: 0;
    }

    .cv-print-header .cv-print-links a {
      color: #555555;
      text-decoration: none;
    }

    main {
      padding: 0.5rem 1rem;
    }

    .cv-intro {
      display: none;
    }

    .tagline {
      font-size: 0.75rem;
    }

    .cv :global(h2) {
      margin: 0.75rem 0 0.35rem;
      font-size: 0.85rem;
    }

    .cv :global(h3) {
      margin: 0.6rem 0 0.1rem;
      font-size: 0.75rem;
    }

    .cv :global(p) {
      font-size: 0.7rem;
      line-height: 1.4;
    }

    .cv :global(li) {
      margin-bottom: 0.1rem;
      font-size: 0.7rem;
      line-height: 1.35;
    }

    .cv :global(ul) {
      margin: 0.15rem 0;
    }

    .cv :global(blockquote) {
      margin: 0.15rem 0;
    }

    .cv :global(blockquote p) {
      font-size: 0.65rem;
      line-height: 1.35;
    }

    .cv :global(h3 em) {
      font-size: 0.6rem;
    }

    .cv :global(dl) {
      font-size: 0.7rem;
      gap: 0.1rem 0.5rem;
      grid-template-columns: 5.5rem 1fr;
      margin-bottom: 0.5rem;
    }

    .cv :global(a) {
      color: #111111;
    }

    .cv :global(a[href]:after) {
      content: none;
    }
  }
</style>
