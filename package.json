{
  "name": "portfolio",
  "type": "module",
  "version": "2.0.0",
  "homepage": "https://petewatters.ie",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm dlx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headless": "playwright test --project chromium",
    "test:e2e:ui": "playwright test --ui",
    "e2e:bdd": "bddgen --config playwright.bdd.config.ts && playwright test --config playwright.bdd.config.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^5.0.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@pagefind/default-ui": "^1.4.0",
    "@playwright/test": "~1.58.2",
    "@typescript-eslint/parser": "^8.55.0",
    "@vite-pwa/astro": "^1.2.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.0.0",
    "playwright-bdd": "^8.5.1",
    "rehype-mermaid": "^3.0.0",
    "vitest": "^2.1.0",
    "workbox-window": "^7.0.0"
  }
}
